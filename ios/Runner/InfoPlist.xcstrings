{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five More"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё пять"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms wake you at the time you choose, even when the app is closed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильники разбудят вас в выбранное время, даже когда приложение закрыто."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan your QR code to complete an alarm challenge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера сканирует ваш QR-код для задания будильника."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a short morning message for yourself. Audio stays on your phone unless you enable audio sync."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите короткое утреннее послание себе. Аудио остаётся на телефоне, пока вы не включите синхронизацию аудио."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion controls the Shake and Maze challenges."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движение телефона управляет заданиями «Тряска» и «Лабиринт»."
          }
        }
      }
    }
  },
  "version": "1.0"
}
